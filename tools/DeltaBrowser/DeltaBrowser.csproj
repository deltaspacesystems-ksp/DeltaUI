<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pomocnik przegladarki dla DeltaUI: wlasny Chromium (CEF) renderujacy do bufora,
    ktory przez TCP na localhoscie leci do wtyczki w KSP. Osobny proces, bo CEF ma
    swoje watki, natywne biblioteki i nie zyje w Mono z Unity.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>DeltaBrowser</AssemblyName>
    <RootNamespace>DeltaBrowser</RootNamespace>
    <CefSharpAnyCpuSupport>false</CefSharpAnyCpuSupport>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Poza GameData: KSP probuje zaladowac KAZDY .dll z GameData, a CEF ma ich kilkadziesiat (natywnych). -->
    <OutputPath>$(MSBuildProjectDirectory)\..\..\dist\DeltaBrowser\</OutputPath>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CefSharp.OffScreen" Version="152.0.60" />
  </ItemGroup>

  <ItemGroup>
    <None Include="adblock-hosts.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
